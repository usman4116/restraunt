# App
NODE_ENV=development
APP_URL=http://localhost:3000

# Database (local PostgreSQL 16)
DATABASE_URL=postgresql://erp:erp@localhost:5432/restaurant_erp

# Redis (optional in dev — leave empty to use in-memory fallback)
REDIS_URL=

# Auth — generate strong secrets for production: openssl rand -base64 48
AUTH_SECRET=dev-only-change-me-please-0123456789abcdef
JWT_ACCESS_TTL=900
JWT_REFRESH_TTL=2592000

# S3 (MinIO in dev)
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=erp-minio
S3_SECRET_KEY=erp-minio-secret
S3_BUCKET=restaurant-erp
S3_REGION=us-east-1

# Email (dev: logged to console unless SMTP set)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=no-reply@restaurant-erp.local
